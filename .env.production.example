# Copy to .env.production on the host and replace every CHANGE_ME value.
APP_VERSION=0.9.0
APP_IMAGE=ai-investment-research-copilot
APP_DOMAIN=research.example.com
DOCS_ENABLED=false

POSTGRES_DB=copilot
POSTGRES_MIGRATION_USER=copilot_migrator
POSTGRES_MIGRATION_PASSWORD=CHANGE_ME_IN_PASSWORD_MANAGER
APP_DATABASE_USER=copilot_app
APP_DATABASE_PASSWORD=CHANGE_ME_IN_PASSWORD_MANAGER
JWT_SIGNING_KEY=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
TOKEN_DIGEST_KEY=CHANGE_ME_TO_A_DIFFERENT_32_CHARACTER_SECRET

SEC_ENABLED=false
SEC_USER_AGENT=AI Investment Research Copilot monitored-email@example.com
BINANCE_SPOT_ENABLED=true
# Enable only after the production host passes the documented reachability and
# jurisdiction review. This integration uses no paid plan or credentials.
BINANCE_FUTURES_ENABLED=false
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_WEIGHT_LIMIT_PER_MINUTE=300
BINANCE_FUTURES_INTERACTIVE_RESERVE=60
COINGECKO_ENABLED=true
COINGECKO_DEMO_API_KEY=
# Version-controlled manifest that passes --require-all-approved.
STOCK_FUNDAMENTALS_MANIFEST_PATH=data/psx/psx_fundamentals.approved.json

# Backup scripts use these values and write outside the repository.
BACKUP_DIRECTORY=/var/backups/investment-copilot
BACKUP_RETENTION_DAYS=7
