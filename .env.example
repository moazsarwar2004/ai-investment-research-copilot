# Safe, non-secret development defaults. Copy this file to .env locally.
APP_NAME=AI Investment Research Co-Pilot
APP_VERSION=0.2.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json
ALLOWED_ORIGINS=http://localhost:8501
DOCS_ENABLED=true
ENABLE_HSTS=false
HSTS_MAX_AGE_SECONDS=31536000

# Local-only Phase 2 infrastructure credentials. These documented defaults are
# not secrets and must be replaced before any shared or internet-facing deploy.
POSTGRES_DB=copilot
POSTGRES_MIGRATION_USER=copilot_migrator
POSTGRES_MIGRATION_PASSWORD=local-migrator-only
APP_DATABASE_USER=copilot_app
APP_DATABASE_PASSWORD=local-app-only
POSTGRES_PORT=5432
REDIS_PORT=6379

DATABASE_URL=postgresql+asyncpg://copilot_app:local-app-only@127.0.0.1:5432/copilot
MIGRATION_DATABASE_URL=postgresql+asyncpg://copilot_migrator:local-migrator-only@127.0.0.1:5432/copilot
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_COMMAND_TIMEOUT_SECONDS=5
DATABASE_PROBE_TIMEOUT_SECONDS=3
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_POOL_RECYCLE_SECONDS=1800

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=copilot:v1
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

