# Safe, non-secret development defaults. Copy this file to .env locally.
APP_NAME=AI Investment Research Co-Pilot
APP_VERSION=0.4.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json
ALLOWED_ORIGINS=http://localhost:8501
DOCS_ENABLED=true
ENABLE_HSTS=false
HSTS_MAX_AGE_SECONDS=31536000

# Local-only Phase 2 infrastructure credentials. These documented defaults are
# not secrets and must be replaced before any shared or internet-facing deploy.
POSTGRES_DB=copilot
POSTGRES_MIGRATION_USER=copilot_migrator
POSTGRES_MIGRATION_PASSWORD=local-migrator-only
APP_DATABASE_USER=copilot_app
APP_DATABASE_PASSWORD=local-app-only
POSTGRES_PORT=5432
REDIS_PORT=6379

DATABASE_URL=postgresql+asyncpg://copilot_app:local-app-only@127.0.0.1:5432/copilot
MIGRATION_DATABASE_URL=postgresql+asyncpg://copilot_migrator:local-migrator-only@127.0.0.1:5432/copilot
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_COMMAND_TIMEOUT_SECONDS=5
DATABASE_PROBE_TIMEOUT_SECONDS=3
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_POOL_RECYCLE_SECONDS=1800

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=copilot:v1
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# Phase 4 provider framework. Individual adapters add their own host allowlists,
# quotas, attribution, terms review, and cache TTL policy.
PROVIDER_CONNECT_TIMEOUT_SECONDS=1
PROVIDER_READ_TIMEOUT_SECONDS=3
PROVIDER_WRITE_TIMEOUT_SECONDS=1
PROVIDER_POOL_TIMEOUT_SECONDS=1
PROVIDER_TOTAL_DEADLINE_SECONDS=5
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_SECONDS=0.1
PROVIDER_RETRY_MAX_SECONDS=1
PROVIDER_RETRY_AFTER_MAX_SECONDS=30
PROVIDER_RESPONSE_MAX_BYTES=2097152
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_RECOVERY_SECONDS=30
PROVIDER_CACHE_LOCK_TTL_SECONDS=10
PROVIDER_CACHE_LOCK_WAIT_SECONDS=1
PROVIDER_CACHE_LOCK_POLL_SECONDS=0.05

# Phase 3 identity. Replace both secrets outside local development. Test tokens
# are returned only for explicit local/test workflows and are forbidden in
# staging and production.
JWT_SIGNING_KEY=local-jwt-signing-key-change-before-sharing-32-bytes
TOKEN_DIGEST_KEY=local-token-digest-key-change-before-sharing-32-bytes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_FAMILY_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
FRESH_AUTH_TTL_MINUTES=15
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_EXPOSE_TEST_TOKENS=true
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

